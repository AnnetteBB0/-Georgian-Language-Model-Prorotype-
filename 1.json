{
  "grammar_system": "Georgian Verbal System",
  "version": "1.0.0",
  "screeves": {
    "series_1": {
      "name": "First Series",
      "subseries": {
        "present_subseries": {
          "present_indicative": {
            "meaning": "Action at the time of speaking or habitual action",
            "english_equivalent": [
              "S/he is verbing",
              "S/he verbs"
            ]
          },
          "imperfect": {
            "meaning": "Incomplete, continuous, or habitual past action",
            "english_equivalent": [
              "S/he was verbing",
              "S/he used to verb",
              "S/he would verb"
            ]
          },
          "present_subjunctive": {
            "meaning": "Unlikely event in the present used as a relative clause",
            "english_equivalent": [
              "That s/he be verbing"
            ]
          }
        },
        "future_subseries": {
          "future": {
            "meaning": "Event taking place in the future",
            "english_equivalent": [
              "S/he will verb"
            ]
          },
          "conditional": {
            "meaning": "Used together with 'if' clauses",
            "english_equivalent": [
              "S/he would verb",
              "S/he would have verbed"
            ]
          },
          "future_subjunctive": {
            "meaning": "Unlikely event in the future used as a dependent clause",
            "english_equivalent": [
              "S/he might verb in the future"
            ]
          }
        }
      }
    },
    "series_2": {
      "name": "Second Series (Aorist Series)",
      "screeves": {
        "aorist": {
          "meaning": "Completed action in the past or imperative commands",
          "english_equivalent": [
            "S/he verbed",
            "Verb!"
          ]
        },
        "optative": {
          "meaning": "Negative imperatives, obligations, hypothetical conditions, and exhortations",
          "english_equivalent": [
            "Do not verb!",
            "S/he must verb",
            "Let's verb"
          ]
        }
      }
    },
    "series_3": {
      "name": "Third Series (Perfective Series)",
      "screeves": {
        "present_perfect": {
          "meaning": "Action not witnessed by the speaker",
          "english_equivalent": [
            "S/he has apparently verbed"
          ]
        },
        "pluperfect": {
          "meaning": "Action that happened before another past event",
          "english_equivalent": [
            "S/he had verbed"
          ]
        },
        "perfect_subjunctive": {
          "meaning": "Mostly used for expressing wishes",
          "english_equivalent": [
            "May s/he verb!"
          ]
        }
      }
    }
  },
  "verb_classes": {
    "class_1": {
      "type": "Transitive Verbs",
      "syntax": {
        "subject": "required",
        "direct_object": "required"
      },
      "sub_types": [
        "causatives",
        "causative verbal forms of adjectives"
      ],
      "examples": [
        "eat",
        "kill",
        "receive"
      ]
    },
    "class_2": {
      "type": "Intransitive Verbs",
      "syntax": {
        "subject": "required",
        "direct_object": "none",
        "indirect_object_case": "dative (optional)"
      },
      "semantics": "Subject typically does not control or perform the action",
      "sub_types": [
        "passive voice of class 1",
        "intransitive forms of adjectives"
      ],
      "examples": [
        "die",
        "happen",
        "be eaten",
        "be killed",
        "become deaf"
      ]
    },
    "class_3": {
      "type": "Medial Verbs",
      "syntax": {
        "subject_case": "ergative (in specific series)",
        "alignment_type": "active alignment",
        "direct_object": "allowed for some verbs"
      },
      "categories": [
        "verbs of motion",
        "weather verbs",
        "loan word derivatives"
      ],
      "examples": [
        "swim",
        "roll",
        "rain",
        "snow",
        "cry",
        "learn",
        "study"
      ]
    },
    "class_4": {
      "type": "Indirect Verbs",
      "syntax": {
        "subject_case": "dative",
        "object_case": "nominative"
      },
      "semantics": "Conveys emotion and prolonged internal states",
      "examples": [
        "want",
        "can",
        "sleep",
        "miss",
        "envy",
        "believe"
      ]
    },
    "stative_verbs": {
      "type": "Pseudo-class",
      "semantics": "Refers to a static state",
      "conjugation_behavior": "resembles class 4 indirect verbs",
      "examples": [
        "hang (as in: the picture is hanging)"
      ]
    },
    "irregular_verbs": {
      "conjugation_behavior": "mostly employs class 2 intransitive system",
      "morphology": "uses different stems across different screeves",
      "examples": [
        "be",
        "come",
        "say",
        "tell",
        "give"
      ]
    }
  }
}